+            tuple(self.exact_plans),
+            capacities,
+            fixed_counts,
+        )
+        if self.capacity_plans:
+            return
+        if exact is not None:
+            self.exact_plans = {rows: exact(rows) for rows in fixed_counts}
+        self.capacity_plans = {rows: capacity(rows) for rows in capacities}
