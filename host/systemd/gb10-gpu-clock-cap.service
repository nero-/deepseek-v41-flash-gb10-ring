[Unit]
Description=GB10 GPU clock policy (driver stock boost)
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service
Before=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi --reset-gpu-clocks
ExecReload=/usr/bin/nvidia-smi --reset-gpu-clocks
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
